# Copy to .env for a live run. Dry-run (`python -m discovery_engine run --dry-run`)
# needs none of these keys.

# LangSmith tracing — EU endpoint
LANGSMITH_API_KEY=replace_me_langsmith_api_key
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=openendo-discovery-engine

# LLM endpoint (OpenAI-compatible). Default: DeepSeek direct.
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace_me_openai_api_key
DISCOVERY_MODEL=deepseek-flash

# Optional: any other OpenAI-compatible endpoint works by swapping the two
# vars above (OpenAI, OpenRouter, OrcaRouter, …). Example, not the default:
# OPENAI_BASE_URL=https://api.orcarouter.ai/v1
# DISCOVERY_MODEL=deepseek/deepseek-v4-flash-0731

# Data source: raw (github) or local (path to wckdboy/openendo checkout)
OPENENDO_SOURCE=raw
# OPENENDO_PATH=/path/to/openendo
